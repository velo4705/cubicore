{
  "name": "cubicore",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cubicore": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js --external @opencode-ai/plugin --external @opencode-ai/sdk && bun build src/cli.ts --target=bun --outfile=dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun run bench/run.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opencode-ai/sdk": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.35",
    "@opencode-ai/sdk": "1.18.35",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
